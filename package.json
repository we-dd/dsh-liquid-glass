{
  "name": "dsh-liquid-glass",
  "version": "1.0.2",
  "private": true,
  "description": "Apple Liquid Glass material for the DeepSeek Harness web UI: refractive glass panels, specular rims and a light-reactive wallpaper.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "liquid-glass",
    "apple",
    "macos",
    "ui"
  ],
  "license": "MIT"
}
